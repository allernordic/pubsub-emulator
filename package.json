{
  "name": "@aller/pubsub-emulator",
  "description": "In-process Google Cloud Pub/Sub emulator for tests, runs the real @google-cloud/pubsub client against a local gRPC server",
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "scripts": {
    "test": "mocha",
    "posttest": "npm run lint && npm run build && npm run test:types && npm run test:md",
    "lint": "eslint . --cache && prettier . -c",
    "prettier": "prettier . -w",
    "test:types": "tsc -p . && tsc -p test",
    "test:md": "node --experimental-vm-modules --no-warnings ./scripts/texample-setup.js",
    "cov:html": "c8 -n src -r html -r text mocha",
    "test:lcov": "c8 -n src -r lcov -r text mocha",
    "build": "dts-buddy && npm run toc",
    "toc": "node ./scripts/toc.js",
    "prepublishOnly": "npm run build"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "google cloud pubsub",
    "pubsub",
    "fake",
    "mock",
    "grpc",
    "emulator"
  ],
  "author": {
    "name": "Aller Nordic",
    "url": "https://github.com/allernordic"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allernordic/pubsub-emulator.git"
  },
  "license": "MIT",
  "dependencies": {
    "smqp": "^13.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@google-cloud/pubsub": "^5.2.0",
    "@grpc/grpc-js": "^1.13.4",
    "@grpc/proto-loader": "^0.8.0",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.1",
    "c8": "^12.0.0",
    "chai": "^6.0.1",
    "debug": "^4.4.1",
    "dts-buddy": "^0.8.3",
    "eslint": "^10.4.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "globals": "^17.6.0",
    "mocha": "^11.7.1",
    "mocha-cakes-2": "^3.3.0",
    "prettier": "^3.6.2",
    "texample": "^1.0.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@google-cloud/pubsub": ">=4",
    "@grpc/grpc-js": "1.x",
    "@grpc/proto-loader": "0.x",
    "debug": ">=4"
  },
  "files": [
    "src",
    "types/index.d*"
  ]
}
